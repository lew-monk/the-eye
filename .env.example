# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://legal_user:legal_pass@localhost:5432/legal_docs

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-api-key-here

# PDF extract strategy: azure (current, default) | pymupdf4llm-hybrid
# Hybrid uses PyMuPDF for native text and pdf-lib + Azure only for scan pages.
# PDF_EXTRACTOR=azure
# PDF_EXTRACT_FALLBACK=azure   # none = fail instead of reverting to Azure
# PDF_EXTRACT_PYTHON=python3
# PDF_EXTRACT_SCRIPT=packages/coreference-worker/src/pdf_extract.py

# Redis (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# Object storage (original PDFs/images) — MinIO locally, S3 in prod
# STORAGE_PROVIDER=none disables persistence (OCR upload still works)
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=the-eye-documents
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Embedding Model Configuration
# openai (default) | ollama
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# Ollama (dev): EMBEDDING_PROVIDER=ollama EMBEDDING_MODEL=nomic-embed-text EMBEDDING_DIMENSIONS=768
# OLLAMA_HOST=http://127.0.0.1:11434
# EMBEDDING_MAX_TOKENS=8192
# Pack size for search chunks (paragraph-scale). Hard-capped by EMBEDDING_MAX_TOKENS.
# PARALEGAL_RETRIEVAL_CHUNK_TOKENS=512
# Legacy alias; min(this, retrieval, embed cap) is the pack size.
# Paralegal text chunks for embeddings (must be ≤ EMBEDDING_MAX_TOKENS; not coref char limit)
# PARALEGAL_CHUNK_MAX_TOKENS=8192

# OCR Confidence Thresholds (Optional - defaults provided)
# CONFIDENCE_THRESHOLD_DEFAULT=0.7
# CONFIDENCE_THRESHOLD_JUDGMENT=0.8
# CONFIDENCE_THRESHOLD_CONTRACT=0.75
# CONFIDENCE_THRESHOLD_POLICE_REPORT=0.7
# CONFIDENCE_THRESHOLD_WITNESS_STATEMENT=0.7
# CONFIDENCE_THRESHOLD_PLEADING=0.75