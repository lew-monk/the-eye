{
  "name": "@workspace/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "start": "bun run dist/index.js",
    "worker": "bun run src/ingestion-worker.ts",
    "worker:dev": "bun --watch src/ingestion-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.0",
    "@elysiajs/cors": "^1.1.0",
    "@workspace/core": "workspace:*",
    "@workspace/ingestion": "workspace:*",
    "@workspace/shared": "workspace:*",
    "@workspace/workers": "workspace:*",
    "ai": "^4.3.0",
    "bullmq": "^5.67.1",
    "elysia": "^1.4.28",
    "memoirist": "^0.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
